# Copiez ce fichier en .env.local puis complétez les valeurs (README.md).
# .env.local n'est jamais envoyé sur Git.

# ─── Supabase (base de données, connexion) — valeurs PUBLIQUES par conception ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Fichiers audio ──
NEXT_PUBLIC_AUDIO_MAX_MB=50

# ─── Connexion simplifiée de l'équipe (serveur uniquement) ──
TEAM_LOGIN_USERNAME=
TEAM_LOGIN_PASSWORD=
TEAM_LOGIN_EMAIL=
TEAM_LOGIN_ACCOUNT_PASSWORD=

# ─── Cloudflare R2 : stockage audio (serveur uniquement, jamais NEXT_PUBLIC_) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bien-aimes-audios
# Facultatif : domaine public du bucket. Vide = URL signées (recommandé).
R2_PUBLIC_URL=

# ─── Migration des anciens audios (compte administrateur) ──
MIGRATION_EMAIL=
MIGRATION_PASSWORD=
