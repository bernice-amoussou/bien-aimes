# ─── Supabase ─────────────────────────────────────────────────────────────
# Supabase › Project Settings › API (ou « Connect » en haut du tableau de bord)
# Ces deux valeurs sont PUBLIQUES par conception : la sécurité repose sur les
# règles RLS de supabase/schema.sql. Ne mettez JAMAIS la clé « service_role »
# (ou « secret ») dans une variable NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://zguemffdrefnruanlukd.supabase.co

# Clé « publishable » (sb_publishable_…) ou, sur un ancien projet, la clé « anon ».
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WE04yHBFnmlyhHGx6u7paA_-2nnRzOy

# ─── Fichiers audio ───────────────────────────────────────────────────────
# Taille maximale acceptée par fichier, en Mo. Doit rester ≤ à la limite
# globale de Supabase Storage (50 Mo sur l'offre gratuite).
NEXT_PUBLIC_AUDIO_MAX_MB=50

# Connexion simplifiée de l'équipe (serveur uniquement, jamais NEXT_PUBLIC_)
TEAM_LOGIN_USERNAME=
TEAM_LOGIN_PASSWORD=
TEAM_LOGIN_EMAIL=
TEAM_LOGIN_ACCOUNT_PASSWORD=
